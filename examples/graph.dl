% Reachability, cycles and unreachable pairs in a small directed graph.
edge(a, b). edge(b, c). edge(c, a). edge(c, d). edge(e, d).

node(X) :- edge(X, _).
node(Y) :- edge(_, Y).

reach(X, Y) :- edge(X, Y).
reach(X, Z) :- reach(X, Y), edge(Y, Z).

on_cycle(X) :- reach(X, X).
unreachable(X, Y) :- node(X), node(Y), X != Y, not reach(X, Y).

?- on_cycle(X).
?- reach(e, X).
?- unreachable(d, X).
